{
  "name": "workoutflex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run sync-exercises && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test lib/plan/plan.test.ts lib/coach/review.test.ts",
    "check-videos": "node --experimental-strip-types --no-warnings scripts/check-videos.ts",
    "sync-exercises": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings scripts/sync-exercises.ts",
    "seed:test": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings scripts/seed-test-user.ts"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.49.4",
    "ai": "7.0.137",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
