# From Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Your deployed URL (used for magic-link redirects when the Origin header is missing)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: weekly AI check-in through the Vercel AI Gateway. Leave empty to turn the feature off.
AI_GATEWAY_API_KEY=
